{
  "name": "tanseek-backend",
  "version": "1.0.0",
  "private": true,
  "description": "P4 - Timetable, Room & Lab Allocation backend (Node.js/Express/PostgreSQL)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
